void setup() {
  Serial.begin(9600);
  Wire.begin();

  pinMode(analogPin, OUTPUT);

  // nunchuk initialize
  nunchuk_init();

  // FastLED initialize
  FastLED.addLeds<CHIPSET, DATA_PIN, COLOR_ORDER>(leds, NUM_LEDS);
  FastLED.setBrightness(BRIGHTNESS);
  FastLED.clear();
  FastLED.show();
}

void loop() {
  int caseValue = 0;
  bool directionFlag = 0;
  idleStart = millis();

  // nunchuk_read() will parse the nunchuk for data
  // don't delete this...
  if (nunchuk_read()) {
    // diagnostic stuff, uncomment "/*" and "*/" to read nunchuk outputs
    /*
    Serial.print("joyX: ");
    Serial.print(nunchuk_joystickX());
    Serial.print("joyY: ");
    Serial.print(nunchuk_joystickY());
    Serial.print("buttonC: ");
    Serial.print(nunchuk_buttonC());
    Serial.print("buttonZ: ");
    Serial.println(nunchuk_buttonZ());
    */
  } else {
    /*
    Serial.print("_");
    */
  }

  // creates bool states for the joystick inputs (digital 1s and 0s instead of analog values)
  // threshold can be changed at the top of the file!
  bool left = nunchuk_joystickX() < (center - threshold);
  bool right = nunchuk_joystickX() > (center + threshold);

  bool up = nunchuk_joystickY() > (center + threshold);
  bool down = nunchuk_joystickY() < (center - threshold);

  bool cButton = nunchuk_buttonC();
  bool zButton = nunchuk_buttonZ();

  // ensuring direction flag is always valid, resets output to caseValue to 0
  if (left + right + up + down >= 1) {
    directionFlag = 1;
  } else {
    directionFlag = 0;
  }

  // caseValue logic and switch, this is where the magic happens!
  caseValue = (left + right * 2 + up * 3 + down * 4 + (cButton * 4 + zButton * 8) * directionFlag);


  // switch(CaseValue), 16 different cases according to 16 different positions
  switch (caseValue) {
    case 0:
      // idle
      for (int i = 0; i < NUM_LEDS; i++) {
        leds[i] = pgm_read_dword(&(relaxed2[i]));
      }
      FastLED.show();
      break;
    case 1:
      // left
      for (int i = 0; i < NUM_LEDS; i++) {
        leds[i] = pgm_read_dword(&(relaxedleft[i]));
      }
      FastLED.show();
      break;
    case 2:
      // right
      for (int i = 0; i < NUM_LEDS; i++) {
        leds[i] = pgm_read_dword(&(relaxedright[i]));
      }
      FastLED.show();
      break;
    case 3:
      // up
      for (int i = 0; i < NUM_LEDS; i++) {
        leds[i] = pgm_read_dword(&(open[i]));
      }
      FastLED.show();
      break;
    case 4:
      // down
      for (int i = 0; i < NUM_LEDS; i++) {
        leds[i] = pgm_read_dword(&(blink[i]));
      }
      FastLED.show();
      break;
    case 5:
      // c + left
      for (int i = 0; i < NUM_LEDS; i++) {
        leds[i] = pgm_read_dword(&(hearts[i]));
      }
      FastLED.show();
      break;
    case 6:
      // c + right
      for (int i = 0; i < NUM_LEDS; i++) {
        leds[i] = pgm_read_dword(&(spiral[i]));
      }
      FastLED.show();
      break;
    case 7:
      // c + up
      for (int i = 0; i < NUM_LEDS; i++) {
        leds[i] = pgm_read_dword(&(openo[i]));
      }
      FastLED.show();
      break;
    case 8:
      // c + down
      for (int i = 0; i < NUM_LEDS; i++) {
        leds[i] = pgm_read_dword(&(exdee[i]));
      }
      FastLED.show();
      break;
    case 9:
      // z + left
      for (int i = 0; i < NUM_LEDS; i++) {
        leds[i] = pgm_read_dword(&(peacerelaxedleft[i]));
      }
      FastLED.show();
      break;
    case 10:
      // z + right
      for (int i = 0; i < NUM_LEDS; i++) {
        leds[i] = pgm_read_dword(&(peacerelaxedright[i]));
      }
      FastLED.show();
      break;
    case 11:
      // z + up
      for (int i = 0; i < NUM_LEDS; i++) {
        leds[i] = pgm_read_dword(&(exclamation[i]));
      }
      FastLED.show();
      break;
    case 12:
      // z + down
      for (int i = 0; i < NUM_LEDS; i++) {
        leds[i] = pgm_read_dword(&(blinkhappy[i]));
      }
      FastLED.show();
      break;
    case 13:
      // c + z + left
      // note, photo-sensitivity warning
      for (int i = 0; i < NUM_LEDS; i++) {
        leds[i] = random();
      }
      FastLED.show();
      delay(100);
      break;
    case 14:
      // c + z + right
      for (int i = 0; i < NUM_LEDS; i++) {
        leds[i] = pgm_read_dword(&(amogus[i]));
      }
      FastLED.show();
      break;
    case 15:
      // c + z + up
      for (int i = 0; i < NUM_LEDS; i++) {
        leds[i] = pgm_read_dword(&(question[i]));
      }
      FastLED.show();
      break;
    case 16:
      // c + z + down
      for (int i = 0; i < NUM_LEDS; i++) {
        leds[i] = pgm_read_dword(&(skeptic[i]));
      }
      FastLED.show();
      break;
  }

  // ..print(caseValue), for reading caseValue and testing purposes, uncomment to monitor caseValue
  // Serial.println(caseValue);

  delay(10);
}