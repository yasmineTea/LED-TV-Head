// FastLED config parameters

// NUM_LEDS, change to adjust for individual needs!
#define NUM_LEDS 128
// DATA_PIN, change to appropriate arduino pin
// Default value = 5
#define DATA_PIN 5
// BRIGHTNESS, from 0 to 255, lower number = less power usage = longer battery life!
// Default value = 32
#define BRIGHTNESS 32
#define COLOR_ORDER GRB
#define CHIPSET WS2812B
CRGB leds[NUM_LEDS];

int analogPin = A0;

// nunchuk config parameters

// threshold, from 0 to 127, lower means more sensitive
// Default value = 120
const int threshold = 120;
const int center = 0;

// other config parameters

unsigned long idleStart = 0;
unsigned long idleRead1 = 0;
unsigned long idleOpen = 5000;
unsigned long idleRead2 = 0;
unsigned long idleClosed = 200; 
unsigned long time_now = 0;


